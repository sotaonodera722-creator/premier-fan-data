FOOTBALL_DATA_API_TOKEN=your_football_data_org_token_here
HIGHLIGHTLY_API_KEY=your_highlightly_api_key_here

# 本番サイトのオリジン。sitemap.xml・robots.txt・OGPタグの絶対URLがここから作られる。
# 未設定なら https://premier-fan-data.vercel.app を使う(src/lib/site.ts)。
# 独自ドメインを取ったとき、あるいは別のホスティングへ移したときはここを変える。
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 の測定ID(G-XXXXXXXXXX)。
# 空のままなら計測タグは出力されず、リクエストも発生しない。
# 本番でのみ設定すること(ローカルとプレビューの閲覧を数字に混ぜないため)。
NEXT_PUBLIC_GA_ID=
